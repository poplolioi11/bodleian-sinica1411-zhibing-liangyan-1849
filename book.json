    {
      "page_id": "f08",
      "index": 8,
      "source_sha256": "73a2a0b132548356d80f13edbf893db62c9fa64c716697c62fe75a24ac59e7b3",
      "width": 3000,
      "height": 2250,
      "official_label": "pp. [12]-[13]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/152957be-92d2-4d0d-8f45-0daed2bfb691.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/152957be-92d2-4d0d-8f45-0daed2bfb691/full/3000,/0/default.jpg",
      "layout_note": "影像與物理面對照：右p12正文；左p13承接欄文「等費」及末題署。單位依固定初錄的物理面及欄序排列；實見印頁碼另列，不補版心題字。敬稱造成的明顯欄內間隔以一個U+3000表示有間隔，不重建實際寬度；行首縮排只在版面註記說明。p12：右至左欄序；明顯欄內抬頭間隔以一個U+3000表明有空白，不還原原圖實際寬度；行首縮排不另造字。 p13：右至左欄序；明顯欄內抬頭間隔以一個U+3000表明有空白，不還原原圖實際寬度；行首縮排不另造字。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "AI-independent-reading-and-nonblind-source-adjudication",
        "later-library-marks": "excluded-described-only"
      },
      "units": [
        {
          "id": "p12-c01",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "等耶穌門人、不圖財禮、不求德報、所以",
          "bbox": null
        },
        {
          "id": "p12-c02",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "斷不欺騙於人、乃欲倣效耶穌之善表",
          "bbox": null
        },
        {
          "id": "p12-c03",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "耳、蓋耶穌普愛衆人、不只其友、卽兼其",
          "bbox": null
        },
        {
          "id": "p12-c04",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "仇、至於捨身代人受死贖罪、令凡信之",
          "bbox": null
        },
        {
          "id": "p12-c05",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "者、可得救、而享天堂之永福也、",
          "bbox": null
        },
        {
          "id": "p12-c06",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "本館亦種洋痘、每日上午開局、痘漿係",
          "bbox": null
        },
        {
          "id": "p12-c07",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "由堅壯嬰兒取出、凡來種者、不須謝金",
          "bbox": null
        },
        {
          "id": "p13-c01",
          "layer": "original-print",
          "role": "colophon",
          "side": "left",
          "text": "等費、",
          "bbox": null
        },
        {
          "id": "p13-c02",
          "layer": "original-print",
          "role": "colophon",
          "side": "left",
          "text": "黃泥涌仁施醫館謹白",
          "bbox": null
        },
        {
          "id": "p13-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "left",
          "text": "六",
          "bbox": null
        }
      ],
      "uncertainties": []
    },
